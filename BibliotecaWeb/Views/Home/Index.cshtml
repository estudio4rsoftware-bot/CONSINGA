@{
    ViewData["Title"] = "Home Page";
}
<div class="row">
<h3>Análisis general</h3>
</div>
<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card bg-info text-white mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="me-3">
                        <h4 class="text-white-75 small">Controles de Campo realizados</h4>
                        <h2 class="text-lg fw-bold" id="htotalControlCampo">1</h2>
                    </div>
                    <i class="fa-solid fa-book fa-2xl"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-primary text-white mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="me-3">
                        <h4 class="text-white-75 small">Monitoreos activos</h4>
                        <h2 class="text-lg fw-bold" id="htotalAlertasActivas">1</h2>
                    </div>
                    <i class="fa-solid fa-user-group fa-2xl"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-warning text-white mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="me-3">
                        <h4 class="text-white-75 small">Admisiones gestionadas</h4>
                        <h2 class="text-lg fw-bold" id="htotalAntecedentes">1</h2>
                    </div>
                    <i class="fa-solid fa-repeat fa-2xl"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card bg-success text-white mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="me-3">
                        <h4 class="text-white-75 small">Controles en Proceso</h4>
                        <h2 class="text-lg fw-bold" id="htotalControlesProceso">1</h2>
                    </div>
                    <i class="fa-solid fa-file-pen fa-2xl"></i>
                </div>
            </div>
        </div>
    </div>
   


</div>
