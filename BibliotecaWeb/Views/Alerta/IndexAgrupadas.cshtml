@section Estilos {
    <link href="~/lib/datatables2/css/datatables.datatables.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

}
<h2 class="mt-4 mb-4">Monitoreo</h2>

<P>
    Esta funcionalidad te permitirá monitorear las alertas agrupadas por la etiqueta. Podrás activar o desactivar el grupo de caravanas.
</P>

<div class="row">
    <div class="col-sm-12">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-chart-bar me-1"></i>
               Monitoreo agrupados
            </div>
            <div class="card-body">
               
                <div class="row">
                    <div class="col-sm-12">
                        <table class="display" id="tbAlerta" cellspacing="0" style="width:100%">
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>



<!-- Incluye Bootstrap JS y dependencias -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>


<div class="modal fade" id="mdAlerta" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Monitoreo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <p>
                        <i class="fas fa-chart-bar me-1"></i>
                        <b>    Datos generales</b>
                    </p>
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Etiqueta:
                        </label>
                        <input type="text" class="form-control" id="txtEtiqueta" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Duración del monitoreo:</label>
                        <select id="cboFrecuencia" class="form-control" data-width="100%"></select>
                    </div>

                </div>

                <div class="row">
                   
                    <p>
                        <br />
                        <i class="fas fa-file-text-o "></i>
                        <b>Ingreso individual o masivo</b>
                        
                    </p>
                   
                    <div class="col-sm-6">
                        <label class="col-form-label">Número de caravana:</label>
                        <input type="text" class="form-control" id="txtNroCaravana" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Lectura de ganado (.txt o .csv):</label>
                        <input type="file" class="form-control" id="fileLecturaCaravana" autocomplete="off">
                    </div>
                </div>

                <div class="row">
                    
                    <p>
                        <br />
                        <i class="fas fa-dollar-sign me-1"></i>
                        <b> Metricas financieras (USD)</b>
                        <br />
                        Puedes llevar un control detallado de los riesgos asumidos
                    </p>
                   
                   
                    
                    <div class="col-sm-6">
                        <label class="col-form-label"> Cantidad de unidades a monitorear:</label>
                        <input type="text" class="form-control" id="txtCantidadCaravanas" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Valor de unidad individual (USD):</label>
                        <input type="text" class="form-control" id="txtValorCaravanas" autocomplete="off">
                    </div>
                </div>

             

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>





@section Scripts {
    <script src="~/lib/datatables2/js/moment.min.js"></script>
    <script src="~/lib/datatables2/js/datatables.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/views/Alerta/AlertaAgrupados.js"></script>

}
    