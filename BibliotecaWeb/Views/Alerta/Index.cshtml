<!-- Incluye Bootstrap JS y dependencias -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>


<div class="modal fade" id="mdAlerta" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Monitoreo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <p>
                        <i class="fas fa-chart-bar me-1"></i>
                        <b>    Datos generales</b>
                    </p>
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Etiqueta:
                        </label>
                        <input type="text" class="form-control" id="txtEtiqueta" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Duración del monitoreo:</label>
                        <select id="cboFrecuencia" class="form-control" data-width="100%"></select>
                    </div>

                </div>

                <div class="row">
                   
                    <p>
                        <br />
                        <i class="fas fa-file-text-o "></i>
                        <b>Ingreso individual o masivo</b>
                        
                    </p>
                   
                    <div class="col-sm-6">
                        <label class="col-form-label">Número de caravana:</label>
                        <input type="text" class="form-control" id="txtNroCaravana" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Lectura de ganado (.txt o .csv):</label>
                        <input type="file" class="form-control" id="fileLecturaCaravana" autocomplete="off">
                    </div>
                </div>

                <div class="row">
                    
                    <p>
                        <br />
                        <i class="fas fa-dollar-sign me-1"></i>
                        <b> Metricas financieras (USD)</b>
                        <br />
                        Puedes llevar un control detallado de los riesgos asumidos
                    </p>
                   
                   
                    
                    <div class="col-sm-6">
                        <label class="col-form-label"> Cantidad de unidades a monitorear:</label>
                        <input type="text" class="form-control" id="txtCantidadCaravanas" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Valor de unidad individual (USD):</label>
                        <input type="text" class="form-control" id="txtValorCaravanas" autocomplete="off">
                    </div>
                </div>

             

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>




<div class="modal fade" id="mdVerAlerta" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Ver Alerta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">Nro de Caravana:</label>
                        <input type="text" class="form-control" id="txtNroCaravanaVer" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Frecuencia:</label>
                        <input type="text" class="form-control" id="txtFrecuenciaVer" autocomplete="off">
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">Fecha Inicio:</label>
                        <input type="text" class="form-control" id="txtFechaInicioVer" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Fecha Fin:</label>
                        <input type="text" class="form-control" id="txtFechaFinVer" autocomplete="off">
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-sm-6">
                        <label class="col-form-label"><b>ACTUAL</b></label>
                   
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label"><b>ANTERIOR</b></label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">Tenencia:</label>
                        <input type="text" class="form-control" id="txtTenenciaActualVer" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Tenencia:</label>
                        <input type="text" class="form-control" id="txtTenenciaAnteriorVer" autocomplete="off">
                    </div>
                    
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">Lugar fisico:</label>
                        <input type="text" class="form-control" id="txtLugarFisicoActualVer" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Lugar fisico:</label>
                        <input type="text" class="form-control" id="txtLugarFisicoAnteriorVer" autocomplete="off">
                    </div>
                </div>

              
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">Propiedad:</label>
                        <input type="text" class="form-control" id="txtPropiedadActualVer" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Propiedad:</label>
                        <input type="text" class="form-control" id="txtPropiedadAnteriorVer" autocomplete="off">
                    </div>
                </div>
                <div class="row">
                   
                    <div class="col-sm-6">
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/lib/datatables2/js/moment.min.js"></script>
    <script src="~/lib/datatables2/js/datatables.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/views/Alerta/Alerta.js"></script>

}
    