@section Estilos {
    <link href="~/lib/datatables2/css/datatables.datatables.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}
<h2 class="mt-4 mb-4">Admisión</h2>
<p> Organiza históricamente tus análisis de otorgamiento de crédito. Ingresa cualquier número de cédula o RUT para que este sea consultado en diferentes base de datos públicos. </p>

<div class="row">
    <div class="col-sm-12">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-chart-bar me-1"></i>
                Histórico de Perfil Crediticio  <i class="fas fa-question-circle-o" aria-hidden="true" title="Crea un Nuevo Perfil Crediticio [por definir]."></i>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-3">
                        <button class="btn btn-outline-success" id="btnNuevoAnalisis">Nuevo análisis</button>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-sm-12">
                        <table class="display dt-ordering-desc" id="tbControl" cellspacing="0" style="width:100%">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdPerfil" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Nuevo análisis</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <p>
                        <i class="fas fa-chart-bar me-1"></i>
                        <b>    Consulta deudas</b>
                    </p>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Periodo/fecha <b>[AAAAMM]</b>
                        </label>
                        <input type="text" class="form-control" id="txtPeriodo" autocomplete="off" maxlength="6">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Pais
                        </label>
                        <select id="cboPais" class="form-select" data-width="100%"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Tipo documento
                        </label>
                        <select id="cboTipoDocumento" class="form-select" data-width="100%"></select>
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Número
                        </label>
                        <input type="text" class="form-control" id="txtNumero" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdPerfilVerResultado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Resultado análisis</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">Nombre</label>  <br />
                        <input type="text" class="form-control" id="txtVerNombre" autocomplete="off" readonly>
                        <input type="hidden" id="hdnIdPerfilCrediticio" value="0" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-4">
                        <label class="col-form-label">Plazo de negocio (días)</label> <i class="fas fa-question-circle-o" id="popoverIconPlazo"></i> <br />
                        <input type="text" class="form-control" id="txtPlazoNegocio" autocomplete="off">
                    </div>
                    <div class="col-sm-4">
                        <label class="col-form-label">No. Operación asociado</label> <i class="fas fa-question-circle-o" id="popoverIconNoOperacion"></i> <br />
                        <input type="text" class="form-control" id="txtNoOperacionAsociado" autocomplete="off">
                    </div>
                    <div class="col-sm-4">
                        <label class="col-form-label">Valor asociado (USD)</label> <i class="fas fa-question-circle-o" id="popoverIconValorAsociado"></i> <br />
                        <input type="text" class="form-control" id="txtValorAsociado" autocomplete="off">
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">Semáforo</label>  <br />
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio1" value="Rojo">
                            <label class="form-check-label" for="inlineRadio1" style="color:red"><b>Rojo</b></label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio2" value="Amarillo">
                            <label class="form-check-label" for="inlineRadio2" style="color:#B3B325"><b>Amarillo</b></label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="inlineRadioOptions" id="inlineRadio3" value="Verde">
                            <label class="form-check-label" for="inlineRadio3" style="color:green"><b>Verde</b></label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">Captura de pantalla</label>  <br />
                        <input type="hidden" id="hdnImagenBase64" />
                        <button id="btnAbrirImagen" class="btn btn-primary">
                            Ver
                        </button>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <label class="col-form-label">Observaciones:</label>  <br />
                        <textarea class="form-control" id="txtVerObservaciones" autocomplete="off" rows="3" style="resize: none;"></textarea>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <table class="table table-responsive table-striped" id="tbCalificacionInstitucion" style="width:100%">
                            <thead>
                                <tr>
                                    <th>Nombre del Banco</th>
                                    <th>Calificación</th>
                                </tr>
                            </thead>
                            <tbody id="CalificacionTableBody">
                                <!-- Dynamic rows will be inserted here -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnVerGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mdPerfilClonar" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Clonar análisis</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <p>
                        <i class="fas fa-chart-bar me-1"></i>
                        <b>    Consulta deudas</b>
                    </p>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Periodo/fecha <b>[AAAAMM]</b>
                        </label>
                        <input type="text" class="form-control" id="txtClonarPeriodo" autocomplete="off" maxlength="6">
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Pais
                        </label>
                        <select id="cboClonarPais" class="form-select" data-width="100%"></select>
                        @* <input type="hidden" name="paisSelected" value="0" /> *@
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Tipo documento
                        </label>
                        <select id="cboClonarTipoDocumento" class="form-select" data-width="100%"></select>
                        @* <input type="hidden" name="tipoDocumentoSelected" value="0" /> *@
                    </div>
                    <div class="col-sm-6">
                        <label class="col-form-label">
                            Número
                        </label>
                        <input type="text" class="form-control" id="txtClonarNumero" autocomplete="off" readonly />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnClonar">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/datatables2/js/moment.min.js"></script>
    <script src="~/lib/datatables2/js/datatables.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/views/PerfilCrediticio/PerfilCrediticio.js"></script>
}