<h2 class="mt-4 mb-4">Antecedentes</h2>

<div class="row">
    <div class="col-sm-12">
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-chart-bar me-1"></i>
               Control de antecedentes
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-sm-3">
                        <button class="btn btn-outline-success" id="btnNuevoAntecedente">Nuevo antecedente</button>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-sm-12">
                        <table class="display" id="tbAntecedente" cellspacing="0" style="width:100%">
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

