                        <div class="input-group">
                            <input type="text" class="form-control" id="txtResultadoDGI" autocomplete="off" readonly>
                            <div class="input-group-append">
                                <button class="btn btn-primary" type="button" onclick="downloadFunction()">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                        </div>
